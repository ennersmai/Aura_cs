# ============================================================================
# Project Panopticon - Environment Configuration
# ============================================================================
# Copy this file to .env and populate with your API keys
# ============================================================================

# --- OpenRouter AI ---
# Get your API key from: https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-xxxxxxxxxxxxxxxxxxxxxxxx
OPENROUTER_MODEL=anthropic/claude-3.5-sonnet

# --- Tavily Search ---
# Get your API key from: https://tavily.com/
TAVILY_API_KEY=tvly-xxxxxxxxxxxxxxxxxxxxxxxx

# --- SurrealDB ---
SURREAL_URL=ws://127.0.0.1:8000/rpc
SURREAL_NS=panopticon
SURREAL_DB=osint
SURREAL_USER=root
SURREAL_PASS=root

# --- NATS ---
NATS_URL=nats://127.0.0.1:4222

# --- ADS-B Telemetry ---
# ADS-B WebSocket endpoint (public feed)
ADSB_WS_URL=wss://api.adsb.lol/api/ws

# Optional: Custom ADS-B feed URL
# ADSB_FEED_URL=https://public-api.adsb.fi/v1/stream

# --- X/Twitter Scraper (Phase 2) ---
# Required for authenticated scraping
X_AUTH_TOKEN=
X_CSRF_TOKEN=
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_SECRET=

# --- Cesium Ion (Optional) ---
# For high-resolution satellite imagery
# Get your access token from: https://cesium.com/ion/
CESIUM_ION_ACCESS_TOKEN=

# --- Application ---
# Server host and port
API_HOST=127.0.0.1
API_PORT=8080
VITE_PORT=5173

# CORS allowed origins
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Logging level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# Enable debug mode
DEBUG=false