    "typescript": "^5.2.2",
    "vite": "^5.1.4",
    "vite-plugin-cesium": "^1.2.22",
    "vitest": "^1.6.0",
    "@vitest/coverage-v8": "^1.6.0",
    "jsdom": "^24.0.0",
    "eslint": "^8.56.0",
    "eslint-plugin-react-hooks": "^4.6.0",
